  /ticket-scan/:
    get:
      operationId: ticket-scan_list
      summary: Scan ticket
      description: |-
        Сканирование билета волонтёром.

        Доступно только пользователям с ролью **volunteer**.
        Если билет уже отсканирован — возвращается время предыдущего сканирования.
      parameters:
      - name: code
        in: query
        description: Ticket code (QR / уникальный код)
        required: true
        type: string
        example: ticket-A1B2C3D4E5F6
      - name: event_id
        in: query
        description: ID мероприятия
        required: true
        type: string
        example: '10'
      responses:
        '200':
          description: Ticket scanned successfully
          schema:
            type: object
            properties:
              message:
                type: string
                example: scan
        '400':
          description: Invalid parameters or access denied
          schema:
            type: object
            properties:
              error:
                type: string
                example: parameter | volunteer
        '403':
          description: Ticket does not belong to this event
          schema:
            type: object
            properties:
              error:
                type: string
                example: event
        '404':
          description: Ticket not found
          schema:
            type: object
            properties:
              error:
                type: string
                example: not-found
        '409':
          description: Ticket already scanned
          schema:
            type: object
            properties:
              error:
                type: string
                example: not-scan
              time:
                type: string
                example: 2026-01-13 15:40
        '401':
          description: Unauthorized
      tags:
      - Tickets
    parameters: []
