swagger: '2.0'
info:
  title: API Documentation
  description: API documentation for your mobile backend
  termsOfService: https://www.google.com/policies/terms/
  contact:
    email: support@example.com
  license:
    name: BSD License
  version: v1
host: 127.0.0.1:8000
schemes:
- http
basePath: /api
consumes:
- application/json
produces:
- application/json
securityDefinitions:
  Basic:
    type: basic
security:
- Basic: []
paths:
  /check-ticket/:
    post:
      operationId: check-ticket_create
      description: ''
      parameters: []
      responses:
        '201':
          description: ''
      tags:
      - check-ticket
    parameters: []
  /check-user-stocks/:
    get:
      operationId: check-user-stocks_list
      summary: Проверка обязательных полей пользователя
      description: 'Проверяет, заполнены ли у пользователя: iin, phone, birth_date,
        personal_account_number.'
      parameters: []
      responses:
        '200':
          description: Все данные заполнены
          examples:
            application/json:
              message: success
        '400':
          description: Отсутствуют обязательные поля
          examples:
            application/json:
              error: iin, phone and birth_date required
      tags:
      - check-user-stocks
    parameters: []
  /connect-apple-wallet/:
    get:
      operationId: connect-apple-wallet_list
      summary: Подключение Apple Wallet
      description: Создаёт Apple Wallet pass для активного акционера и возвращает
        ссылку на скачивание.
      parameters: []
      responses:
        '200':
          description: Успешно
          schema:
            type: object
            properties:
              downloadUrl:
                type: string
                example: https://apple.com/pass.pkpass
        '404':
          description: Акционер не найден
          schema:
            type: object
            properties:
              error:
                type: string
                example: Shareholder does not exist
        '500':
          description: Ошибка конфигурации
          schema:
            type: object
            properties:
              error:
                type: string
                example: No apple token
        '418':
          description: Ошибка Apple Wallet сервиса
          schema:
            type: object
            properties:
              error:
                type: string
                example: Failed with yekinsgin
      tags:
      - Apple Wallet
    parameters: []
  /create-ticket/:
    post:
      operationId: create-ticket_create
      summary: Create ticket payment
      description: Создание платежа и билетов на мероприятие
      parameters:
      - name: data
        in: body
        required: true
        schema:
          required:
          - EMAIL
          - TELEPHONE
          - EVENT_ID
          - COUNT
          - TYPE
          type: object
          properties:
            EMAIL:
              description: Email покупателя
              type: string
              example: user@mail.com
            TELEPHONE:
              description: Телефон покупателя
              type: string
              example: '+77001234567'
            EVENT_ID:
              description: ID мероприятия
              type: integer
              example: 12
            COUNT:
              description: Количество билетов (макс 3 на пользователя)
              type: integer
              example: 2
            TYPE:
              description: Тип покупки
              type: string
              example: ticket
            LOCALE:
              description: Локаль (ru / en / kz)
              type: string
              example: ru
              nullable: true
            FIO:
              description: ФИО пользователя
              type: string
              example: Ivan Ivanov
              nullable: true
      responses:
        '200':
          description: Payment URL created
          schema:
            type: object
            properties:
              url:
                type: string
                example: https://bank.example.com/pay?ORDER=123456
        '400':
          description: Validation error
          schema:
            type: object
            properties:
              error:
                type: string
                example: EMAIL, TELEPHONE, COUNT, TYPE and EVENT_ID is required!
        '401':
          description: Unauthorized
        '500':
          description: Bank error
          schema:
            type: object
            properties:
              error:
                type: string
                example: Error. Response from bank not 200
      tags:
      - Tickets
    parameters: []
  /create-user-shareholder/:
    post:
      operationId: create-user-shareholder_create
      summary: Создать пользователя и акционера
      description: "\nСоздаёт нового пользователя и объект акционера.  \nДоступно
        только для пользователей с ролью **superadmin**.\nЕсли пользователь с таким
        email уже существует — он будет использован повторно.\n"
      parameters:
      - name: data
        in: body
        required: true
        schema:
          required:
          - email
          - full_name
          - role
          - iin
          - phone
          - birth_date
          - personal_account_number
          - share_count
          type: object
          properties:
            email:
              type: string
              example: user@example.com
            full_name:
              type: string
              example: Иванов Иван Иванович
            role:
              type: string
              example: shareholder
            iin:
              type: string
              example: '123456789012'
            phone:
              type: string
              example: '+77011234567'
            birth_date:
              type: string
              example: '1990-05-10'
            personal_account_number:
              type: string
              example: '123456789'
            share_count:
              type: integer
              example: 10
      responses:
        '201':
          description: Успешное создание
          examples:
            application/json:
              message: Success
        '400':
          description: Не переданы аргументы
          examples:
            application/json:
              error: Arguments is required
        '406':
          description: Нет прав доступа
          examples:
            application/json:
              error: No permission
        '500':
          description: Ошибка на стороне сервера
      tags:
      - create-user-shareholder
    parameters: []
  /event-limit/:
    get:
      operationId: event-limit_list
      summary: Get user ticket count for event
      description: Возвращает количество **активных** билетов текущего пользователя
        для конкретного мероприятия.
      parameters:
      - name: EVENT_ID
        in: query
        description: ID мероприятия
        required: true
        type: integer
        example: 7
      responses:
        '200':
          description: Ticket count
          schema:
            type: object
            properties:
              message:
                description: Количество активных билетов
                type: string
                example: '2'
        '400':
          description: Missing EVENT_ID
          schema:
            type: object
            properties:
              error:
                type: string
                example: EVENT_ID is required!
        '401':
          description: Unauthorized
        '404':
          description: Event not found
          schema:
            type: object
            properties:
              error:
                type: string
                example: not-found
      tags:
      - Events
      - Tickets
    parameters: []
  /events/:
    get:
      operationId: events_list
      summary: List events
      description: Получить список всех мероприятий
      parameters: []
      responses:
        '200':
          description: ''
          schema:
            type: array
            items:
              $ref: '#/definitions/Event'
      tags:
      - Events (Admin)
    post:
      operationId: events_create
      summary: Create event
      description: Создание нового мероприятия
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Event'
      responses:
        '201':
          description: ''
          schema:
            $ref: '#/definitions/Event'
        '400':
          description: Validation error
      tags:
      - Events (Admin)
    parameters: []
  /events/{id}/:
    get:
      operationId: events_read
      summary: Retrieve event
      description: Получить мероприятие по ID
      parameters: []
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Event'
        '404':
          description: Not found
      tags:
      - Events (Admin)
    put:
      operationId: events_update
      summary: Update event
      description: Полное обновление мероприятия
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Event'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Event'
        '400':
          description: Validation error
        '404':
          description: Not found
      tags:
      - Events (Admin)
    patch:
      operationId: events_partial_update
      summary: Partial update event
      description: Частичное обновление мероприятия
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Event'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Event'
        '400':
          description: Validation error
        '404':
          description: Not found
      tags:
      - Events (Admin)
    delete:
      operationId: events_delete
      summary: Delete event
      description: Удаление мероприятия
      parameters: []
      responses:
        '204':
          description: No content
        '404':
          description: Not found
      tags:
      - Events (Admin)
    parameters:
    - name: id
      in: path
      description: A unique integer value identifying this event.
      required: true
      type: integer
  /export-shareholders/:
    get:
      operationId: export-shareholders_list
      summary: Экспорт акционеров
      description: Экспорт акционеров в Excel с фильтрацией по всем полям
      parameters:
      - name: start_date
        in: query
        description: Начало периода создания (YYYY-MM-DD)
        required: false
        type: string
      - name: end_date
        in: query
        description: Окончание периода создания (YYYY-MM-DD)
        required: false
        type: string
      - name: full_name
        in: query
        description: Фильтр по ФИО (частичное совпадение)
        required: false
        type: string
      - name: phone
        in: query
        description: Фильтр по телефону (частичное совпадение)
        required: false
        type: string
      - name: email
        in: query
        description: Фильтр по email (частичное совпадение)
        required: false
        type: string
      - name: shares_count_min
        in: query
        description: Минимальное количество акций
        required: false
        type: integer
      - name: shares_count_max
        in: query
        description: Максимальное количество акций
        required: false
        type: integer
      - name: shareholder_level
        in: query
        description: Уровень акционера (1, 2, 3, 4)
        required: false
        type: string
      - name: bonus_status
        in: query
        description: Статус бонусов (true/false)
        required: false
        type: boolean
      - name: e_certificate
        in: query
        description: Наличие E-сертификата (true/false)
        required: false
        type: boolean
      - name: payment_status
        in: query
        description: Фильтр по payment_status
        required: false
        type: string
      - name: user_ticket_cabinet_id
        in: query
        description: ID пользователя кабинета
        required: false
        type: integer
      responses:
        '200':
          description: Файл Excel
          schema:
            type: string
            format: binary
          examples:
            application/vnd.openxmlformats-officedocument.spreadsheetml.sheet: {}
        '400':
          description: Неверные параметры
        '403':
          description: Доступ запрещен
      tags:
      - Акционеры
    parameters: []
  /export-tickets/:
    get:
      operationId: export-tickets_list
      summary: Export tickets to Excel
      description: |-
        Экспорт билетов по мероприятию в Excel файл.

        Доступно только администраторам.
        Возвращает файл `.xlsx` со статистикой билетов.
      parameters:
      - name: EVENT_ID
        in: query
        description: ID мероприятия
        required: true
        type: integer
        example: 5
      responses:
        '200':
          description: Excel file with tickets statistics
          schema:
            type: string
            format: binary
        '400':
          description: Invalid parameters
          schema:
            type: object
            properties:
              error:
                type: string
                example: parameter
        '401':
          description: Unauthorized
        '403':
          description: Admin only
        '404':
          description: Event not found
          schema:
            type: object
            properties:
              error:
                type: string
                example: not-found
      tags:
      - Tickets
      - Export
    parameters: []
  /get-events:
    get:
      operationId: get-events_list
      summary: Get all events
      description: |-
        Получить список всех мероприятий.

        Доступно всем пользователям (без авторизации).
      parameters: []
      responses:
        '200':
          description: List of events
          schema:
            type: array
            items:
              $ref: '#/definitions/Event'
        '500':
          description: Server error
          schema:
            type: string
            example: 'Traceback (most recent call last): ...'
      tags:
      - Events
    parameters: []
  /get-ticket/:
    get:
      operationId: get-ticket_list
      description: Получение билета
      parameters:
      - name: ORDER
        in: query
        description: Номер заказа
        required: true
        type: string
      responses:
        '200':
          description: Билет отправлен успешно
        '400':
          description: Номер заказа обязателен
        '404':
          description: Билет не найден
        '500':
          description: Ошибка при отправке билета
      tags:
      - get-ticket
    parameters: []
  /get-tickets-by-user/:
    get:
      operationId: get-tickets-by-user_list
      summary: Get my tickets
      description: |-
        Получить список билетов текущего авторизованного пользователя.

        Возвращаются билеты со статусом **Active** и **Deactive**.
      parameters: []
      responses:
        '200':
          description: List of user tickets
          schema:
            type: array
            items:
              $ref: '#/definitions/GetTicket'
        '401':
          description: Unauthorized
        '404':
          description: Tickets not found
          schema:
            type: object
            properties:
              error:
                type: string
                example: Билет не найден
      tags:
      - Tickets
    parameters: []
  /get-tickets-count/:
    get:
      operationId: get-tickets-count_list
      description: Получить количество билетов для указанного события
      parameters:
      - name: EVENT_ID
        in: query
        description: ID события, для которого нужно получить количество билетов
        required: true
        type: integer
      responses:
        '200':
          description: Количество билетов
          examples:
            application/json:
              message: '42'
        '400':
          description: Ошибка в запросе
          examples:
            application/json:
              error: EVENT_ID is required!
        '500':
          description: Ошибка сервера
          examples:
            application/json:
              error: Server error
      tags:
      - get-tickets-count
    parameters: []
  /is-admin/:
    get:
      operationId: is-admin_list
      summary: Check admin status
      description: |-
        Проверяет, является ли текущий авторизованный пользователь администратором.

        `is_staff = true` → администратор.
        `is_staff = false` → не администратор.
      parameters: []
      responses:
        '200':
          description: User is admin
          schema:
            type: object
            properties:
              message:
                type: string
                example: Пользователь является администратором
              role:
                type: string
                example: admin
        '403':
          description: User is not admin
          schema:
            type: object
            properties:
              message:
                type: string
                example: Пользователь не является администратором
              role:
                type: string
                example: user
        '401':
          description: Unauthorized
      tags:
      - Auth
      - Admin
    parameters: []
  /login/:
    post:
      operationId: login_create
      description: ''
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/CustomTokenObtainPair'
      responses:
        '200':
          description: ''
          schema:
            required:
            - access
            - refresh
            - role
            type: object
            properties:
              access:
                type: string
              refresh:
                type: string
              role:
                type: string
      tags:
      - login
    parameters: []
  /my-shareholder/:
    get:
      operationId: my-shareholder_list
      summary: Мой акционер
      description: Получить запись акционера, связанную с текущим пользователем
      parameters: []
      responses:
        '200':
          description: Найдена запись акционера
          schema:
            $ref: '#/definitions/Shareholder'
        '404':
          description: Запись акционера не найдена
        '401':
          description: Не авторизован
      tags:
      - Акционеры
    parameters: []
  /purchase-share/:
    post:
      operationId: purchase-share_create
      summary: Покупка акционерных долей
      description: Создаёт платёж и возвращает URL платежной формы Jusan.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          required:
          - count
          - locale
          type: object
          properties:
            count:
              description: Количество долей
              type: integer
              example: 3
            locale:
              description: Локаль
              type: string
              example: ru
      responses:
        '200':
          description: ''
          schema:
            type: object
            properties:
              url:
                description: URL для оплаты
                type: string
        '400':
          description: Invalid input data
        '401':
          description: Unauthorized
        '500':
          description: ''
          schema:
            type: object
            properties:
              error:
                type: string
                example: Error. Response from bank not 200
      tags:
      - purchase-share
    parameters: []
  /reset-password/:
    post:
      operationId: reset-password_create
      description: Сброс пароля пользователя
      parameters:
      - name: data
        in: body
        required: true
        schema:
          required:
          - email
          - code
          - new_password
          type: object
          properties:
            email:
              description: Email пользователя
              type: string
            code:
              description: Код подтверждения
              type: string
            new_password:
              description: Новый пароль пользователя
              type: string
      responses:
        '200':
          description: Пароль успешно сброшен
        '400':
          description: Неверный код или обязательные поля отсутствуют
        '404':
          description: Пользователь не найден
        '500':
          description: Ошибка при сбросе пароля
      tags:
      - reset-password
    parameters: []
  /send-code/:
    post:
      operationId: send-code_create
      description: Отправка кода подтверждения на email
      parameters:
      - name: data
        in: body
        required: true
        schema:
          required:
          - email
          - type
          - cabinet
          type: object
          properties:
            email:
              description: Email
              type: string
            iin:
              description: Код подтверждения
              type: string
            phone:
              description: Код подтверждения
              type: string
            personal_account_number:
              description: н.ц.д.
              type: string
            type:
              description: Тип кода
              type: string
            cabinet:
              description: cabinet
              type: string
      responses:
        '200':
          description: Код отправлен успешно
        '400':
          description: Номер телефона обязателен
        '406':
          description: Unique
        '500':
          description: Ошибка при отправке кода
      tags:
      - send-code
    parameters: []
  /send-shareholder-certificate/:
    post:
      operationId: send-shareholder-certificate_create
      summary: Отправка сертификата акционера
      description: Отправить сертификат акционера на email (данные в body)
      parameters:
      - name: data
        in: body
        required: true
        schema:
          required:
          - shareholder_id
          type: object
          properties:
            shareholder_id:
              type: integer
      responses:
        '200':
          description: Сертификат успешно отправлен
          schema:
            required:
            - shareholder_id
            - message
            - email
            type: object
            properties:
              message:
                type: string
              shareholder_id:
                type: integer
              email:
                type: string
        '400':
          description: Неверные данные
        '403':
          description: Доступ запрещен - требуется роль admin или superadmin
        '404':
          description: Акционер не найден
        '500':
          description: Ошибка при отправке сертификата
      tags:
      - Акционеры - Сертификаты
    parameters: []
  /shareholder-scan/:
    get:
      operationId: shareholder-scan_list
      summary: Scan shareholder QR/code
      description: |-
        Сканирование shareholder-кода волонтёром.

        Требуется роль пользователя: **volunteer**.
        Если код уже использовался для данного event — возвращается 409.
      parameters:
      - name: code
        in: query
        description: Shareholder code (QR / уникальный код)
        required: true
        type: string
        example: SHR-ABC123
      - name: event_id
        in: query
        description: ID мероприятия
        required: true
        type: string
        example: '15'
      responses:
        '200':
          description: Scan successful
          schema:
            type: object
            properties:
              message:
                type: string
                example: scan
              time:
                type: string
                example: 2026-01-13+14:22
              full_name:
                type: string
                example: Ivan Ivanov
              shareholder_level:
                type: string
                example: Gold
              bonus_status:
                type: boolean
                example: true
        '400':
          description: Invalid request or access denied
          schema:
            type: object
            properties:
              error:
                type: string
                example: volunteer | parameter
        '401':
          description: Unauthorized
        '404':
          description: Shareholder not found
          schema:
            type: object
            properties:
              error:
                type: string
                example: not-found
        '409':
          description: Code already used for this event
          schema:
            type: object
            properties:
              error:
                type: string
                example: used
              time:
                type: string
                example: 2026-01-13+13:55
              full_name:
                type: string
                example: Ivan Ivanov
              shareholder_level:
                type: string
                example: Gold
              bonus_status:
                type: boolean
                example: true
      tags:
      - Shareholders
    parameters: []
  /shareholders/:
    get:
      operationId: shareholders_list
      summary: Список акционеров с аккаунтом
      description: Получить список всех акционеров с информацией о связанном аккаунте
      parameters: []
      responses:
        '200':
          description: Список акционеров получен успешно
          schema:
            type: array
            items:
              $ref: '#/definitions/Shareholder'
        '403':
          description: Доступ запрещен - требуется роль admin
      tags:
      - Акционеры
    post:
      operationId: shareholders_create
      summary: Создание акционера
